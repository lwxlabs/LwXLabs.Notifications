<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LwXLabs.Notifications.Firebase</PackageId>
    <Description>Firebase Cloud Messaging transport for LwXLabs.Notifications.</Description>
    <PackageTags>notifications;firebase;fcm;push;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LwXLabs.Notifications.AspNetCore/LwXLabs.Notifications.AspNetCore.csproj" />
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
  </ItemGroup>
</Project>
