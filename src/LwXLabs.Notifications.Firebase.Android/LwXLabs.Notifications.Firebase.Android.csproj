<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <PackageId>LwXLabs.Notifications.Firebase.Android</PackageId>
    <Description>Reusable Android Firebase Cloud Messaging receiver for LwXLabs.Notifications.</Description>
    <PackageTags>notifications;firebase;fcm;android;push</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
