<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LwXLabs.Notifications.AspNetCore</PackageId>
    <Description>ASP.NET Core server engine for LwXLabs.Notifications with SignalR and durable LwXLabs.Flow messaging.</Description>
    <PackageTags>notifications;aspnetcore;signalr;flow;outbox;efcore</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../LwXLabs.Notifications.Abstractions/LwXLabs.Notifications.Abstractions.csproj" />
    <PackageReference Include="LwXLabs.Flow.Messaging" Version="1.2.8" />
    <PackageReference Include="LwXLabs.Flow.EntityFrameworkCore" Version="1.2.8" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LwXLab.Data.EntityFrameworkCore" Version="0.1.0-preview.3" />
  </ItemGroup>
</Project>
