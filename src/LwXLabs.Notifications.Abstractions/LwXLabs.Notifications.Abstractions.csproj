    <PackageId>LwXLabs.Notifications.Abstractions</PackageId>
    <Description>Transport-neutral contracts for LwXLabs.Notifications.</Description>
    <PackageTags>notifications;push;signalr;components;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
